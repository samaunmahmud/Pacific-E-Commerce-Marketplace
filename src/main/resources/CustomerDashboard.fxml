<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<BorderPane fx:id="mainLayout" prefHeight="900.0" prefWidth="1300.0"
            stylesheets="@style.css"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17"
            fx:controller="UITest1.UITest1.CustomerDashboardController">
    <top>
        <fx:include source="SharedTab.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: white; -fx-border-color: transparent;">
            <content>
                <VBox spacing="30.0" style="-fx-padding: 40 80;">
                    <children>

                        <!-- ── UNRATED PRODUCTS HEADER ── -->
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <VBox spacing="5">
                                    <Label text="List of unrated products,"
                                           style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #333;" />
                                    <Label text="Items you recently purchased"
                                           style="-fx-text-fill: #888;" />
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label onMouseClicked="#navigateToMoreProducts"
                                       text="More" styleClass="view-all-link" />
                                <Button text="⋮" styleClass="three-dots-btn"
                                        onAction="#handleMoreOptions" />
                            </children>
                        </HBox>

                        <!-- ── PRODUCT CARDS GRID ── -->
                        <GridPane fx:id="productsGrid" hgap="25.0" vgap="25.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25" />
                                <ColumnConstraints percentWidth="25" />
                                <ColumnConstraints percentWidth="25" />
                                <ColumnConstraints percentWidth="25" />
                            </columnConstraints>
                            <children>
                                <VBox spacing="15" styleClass="product-card" GridPane.columnIndex="0">
                                    <Label text="iPhone 17 Max" styleClass="product-title-text" />
                                    <Label text="£1,199.00" styleClass="product-price" />
                                    <Button text="Write Review" styleClass="submit-btn"
                                            maxWidth="Infinity" onAction="#handleWriteReview" />
                                </VBox>
                                <VBox spacing="15" styleClass="product-card" GridPane.columnIndex="1">
                                    <Label text="KTC 34'' Monitor" styleClass="product-title-text" />
                                    <Label text="£459.00" styleClass="product-price" />
                                    <Button text="Write Review" styleClass="submit-btn"
                                            maxWidth="Infinity" onAction="#handleWriteReview" />
                                </VBox>
                                <VBox spacing="15" styleClass="product-card" GridPane.columnIndex="2">
                                    <Label text="Sony WH-1000XM5" styleClass="product-title-text" />
                                    <Label text="£299.00" styleClass="product-price" />
                                    <Button text="Write Review" styleClass="submit-btn"
                                            maxWidth="Infinity" onAction="#handleWriteReview" />
                                </VBox>
                                <VBox spacing="15" styleClass="product-card" GridPane.columnIndex="3">
                                    <Label text="Logitech MX Master" styleClass="product-title-text" />
                                    <Label text="£99.00" styleClass="product-price" />
                                    <Button text="Write Review" styleClass="submit-btn"
                                            maxWidth="Infinity" onAction="#handleWriteReview" />
                                </VBox>
                            </children>
                        </GridPane>

                        <!-- ── SEARCH + SORT ROW ── -->
                        <VBox spacing="20" alignment="CENTER">
                            <children>
                                <HBox spacing="20.0" alignment="CENTER">
                                    <children>

                                        <!-- Red themed search bar -->
                                        <HBox alignment="CENTER_LEFT"
                                              prefHeight="44.0"
                                              prefWidth="500.0"
                                              styleClass="customer-search-box">
                                            <children>
                                                <Label text="🔍"
                                                       styleClass="customer-search-icon"
                                                       style="-fx-padding: 0 8 0 12;" />
                                                <TextField fx:id="searchField"
                                                           promptText="Search your reviews..."
                                                           onKeyReleased="#handleSearchAndSort"
                                                           styleClass="customer-search-field"
                                                           HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>

                                        <!-- Red fully curved sort ComboBox -->
                                        <ComboBox fx:id="sortComboBox"
                                                  onAction="#handleSearchAndSort"
                                                  prefHeight="44.0"
                                                  prefWidth="190.0"
                                                  promptText="Sort by">
                                            <items>
                                                <FXCollections fx:factory="observableArrayList">
                                                    <String fx:value="Newest" />
                                                    <String fx:value="Highest Rating" />
                                                    <String fx:value="Lowest Rating" />
                                                    <String fx:value="Most Helpful" />
                                                </FXCollections>
                                            </items>
                                        </ComboBox>

                                    </children>
                                </HBox>
                                <Separator />
                            </children>
                            <VBox.margin>
                                <Insets top="20.0" bottom="10.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- ── RECENTLY RATED REVIEWS ── -->
                        <VBox spacing="20.0">
                            <children>
                                <Label text="Recently Rated Products"
                                       style="-fx-font-size: 26; -fx-font-weight: bold;" />
                                <VBox fx:id="reviewsContainer" spacing="15.0" />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
