<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="UITest1.UITest1.SharedTabController"
      stylesheets="@style.css">

    <!-- TOP HEADER BAR -->
    <HBox alignment="CENTER_LEFT"
          prefHeight="100.0"
          minHeight="100.0"
          maxHeight="100.0"
          styleClass="header-box"
          spacing="20.0">
        <padding>
            <Insets left="30.0" right="30.0" />
        </padding>
        <children>

            <!-- Pacific Logo + Location -->
            <VBox alignment="CENTER_LEFT" spacing="2">
                <children>
                    <Label text="Pacific ★"
                           styleClass="logo-text"
                           onMouseClicked="#goHome" />
                    <HBox alignment="CENTER_LEFT" spacing="4">
                        <children>
                            <Label text="📍"
                                   style="-fx-font-size: 12px;" />
                            <Label text="Uxbridge, England"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                                          -fx-text-fill: #333;" />
                        </children>
                    </HBox>
                </children>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT"
                  prefHeight="38.0"
                  minHeight="38.0"
                  maxHeight="38.0"
                  prefWidth="520.0"
                  styleClass="search-container">
                <children>
                    <Label text="🔍"
                           style="-fx-font-size: 14px; -fx-text-fill: #860752;
                                  -fx-padding: 0 8 0 14;" />
                    <TextField fx:id="searchField"
                               promptText="Search Pacific..."
                               styleClass="transparent-search"
                               prefHeight="38.0"
                               minHeight="38.0"
                               maxHeight="38.0"
                               HBox.hgrow="ALWAYS" />
                    <Button text="Search"
                            onAction="#handleSearch"
                            styleClass="search-submit-btn"
                            prefHeight="38.0"
                            minHeight="38.0"
                            maxHeight="38.0" />
                </children>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <!-- Right Side: Account, Orders, Cart, Logout -->
            <HBox alignment="CENTER" spacing="20.0">
                <children>

                    <!-- Account and Lists -->
                    <VBox alignment="CENTER_LEFT" spacing="2"
                          styleClass="action-item"
                          onMouseClicked="#handleProfile">
                        <children>
                            <Label text="Hello, sign in"
                                   style="-fx-font-size: 11px; -fx-text-fill: #555;" />
                            <Label text="Account and Lists"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                                          -fx-text-fill: #222;" />
                        </children>
                    </VBox>

                    <!-- Returns and Orders -->
                    <VBox alignment="CENTER_LEFT" spacing="2"
                          styleClass="action-item"
                          onMouseClicked="#handleOrders">
                        <children>
                            <Label text="Returns"
                                   style="-fx-font-size: 11px; -fx-text-fill: #555;" />
                            <Label text="and Orders"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                                          -fx-text-fill: #222;" />
                        </children>
                    </VBox>

                    <!-- Cart -->
                    <VBox alignment="CENTER" spacing="2"
                          styleClass="action-item"
                          onMouseClicked="#handleCart">
                        <children>
                            <ImageView fitHeight="30.0" preserveRatio="true">
                                <Image url="@cart1.png" />
                            </ImageView>
                            <Label text="Cart"
                                   style="-fx-font-size: 13px; -fx-font-weight: bold;
                                          -fx-text-fill: #222;" />
                        </children>
                    </VBox>

                    <!-- Logout -->
                    <VBox alignment="CENTER" spacing="2"
                          styleClass="action-item logout-item"
                          onMouseClicked="#handleLogout">
                        <children>
                            <StackPane>
                                <Circle radius="18" fill="WHITE"
                                        stroke="#860752" strokeWidth="1.5"/>
                                <ImageView fitHeight="22.0" preserveRatio="true">
                                    <Image url="@avatarCustomerLogin.png" />
                                </ImageView>
                            </StackPane>
                            <Label text="Logout"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-text-fill: #860752;" />
                        </children>
                    </VBox>

                </children>
            </HBox>
        </children>
    </HBox>

    <!-- NAVIGATION BAR — items spread evenly across full width -->
    <HBox alignment="CENTER"
          prefHeight="40.0"
          minHeight="40.0"
          maxHeight="40.0"
          styleClass="nav-bar">
        <padding>
            <Insets left="30.0" right="30.0" />
        </padding>
        <children>
            <Label text="☰ All"          styleClass="nav-link-bold" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Today's Deals"  styleClass="nav-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Groceries"      styleClass="nav-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Best Seller"    styleClass="nav-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Pacific Basics" styleClass="nav-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="New Releases"   styleClass="nav-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Shop now"       styleClass="nav-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Pacific"        styleClass="nav-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Registry"       styleClass="nav-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Reviews"        styleClass="nav-link" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Cart"           styleClass="nav-link" />
        </children>
    </HBox>

</VBox>