<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="900.0" prefWidth="1300.0" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="UITest1.UITest1.UnratedProductsPageController">
    <top>
        <fx:include source="SharedTab.fxml" />
    </top>
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: white; -fx-border-color: transparent;">
            <content>
                <VBox spacing="30.0" style="-fx-padding: 50 80;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="20">
                            <children>
                                <Button onAction="#navigateBack"
                                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 24;"
                                        text="←" />
                                <VBox spacing="5">
                                    <Label text="Unrated Products"
                                           style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: #333;" />
                                    <Label text="Items waiting for your feedback"
                                           style="-fx-text-fill: #888;" />
                                </VBox>
                            </children>
                        </HBox>

                        <GridPane fx:id="productGrid" hgap="25.0" vgap="40.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                                <ColumnConstraints percentWidth="25.0" />
                            </columnConstraints>
                        </GridPane>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
