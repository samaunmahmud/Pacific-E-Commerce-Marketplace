<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<TabPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.MainController" tabClosingPolicy="UNAVAILABLE" prefWidth="1280.0" prefHeight="800.0">
    <tabs>
        <Tab text="Login Screen">
            <AnchorPane style="-fx-background-color: #ffffff;">
                <children>
                    <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="800.0" prefWidth="600.0" style="-fx-background-color: #edebff;">
                        <children>
                            <Label layoutX="100.0" layoutY="350.0" text="Welcome to Pacific" textFill="#73114b">
                                <font>
                                    <Font name="System Bold" size="40.0" />
                                </font>
                            </Label>
                        </children>
                    </AnchorPane>

                    <VBox layoutX="700.0" layoutY="150.0" prefWidth="420.0" spacing="32.0">
                        <children>
                            <VBox spacing="10.0">
                                <Label text="Login to your Account" textFill="#7f265b">
                                    <font>
                                        <Font name="System Bold" size="36.0" />
                                    </font>
                                </Label>
                            </VBox>

                            <VBox spacing="24.0">
                                <VBox spacing="8.0">
                                    <Label text="Email" textFill="#828282">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <TextField fx:id="emailField" promptText="mail@abc.com" prefHeight="45.0" style="-fx-border-color: #ded2d9; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #ffffff; -fx-padding: 10;" />
                                </VBox>

                                <VBox spacing="8.0">
                                    <Label text="Password" textFill="#828282">
                                        <font>
                                            <Font name="System Bold" size="14.0" />
                                        </font>
                                    </Label>
                                    <PasswordField fx:id="passwordField" promptText="*****************" prefHeight="45.0" style="-fx-border-color: #ded2d9; -fx-border-radius: 5; -fx-background-radius: 5; -fx-background-color: #ffffff; -fx-padding: 10;" />
                                </VBox>
                            </VBox>

                            <HBox alignment="CENTER_LEFT" spacing="180.0">
                                <CheckBox text="Remember Me" textFill="#a1a1a1" />
                                <Label text="Forgot Password?" textFill="#7f265b" style="-fx-cursor: hand;">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </HBox>

                            <Button mnemonicParsing="false" onAction="#handleLogin" prefHeight="50.0" prefWidth="420.0" style="-fx-background-color: #7f265b; -fx-text-fill: #ffffff; -fx-background-radius: 6;" text="Login">
                                <font>
                                    <Font name="System Bold" size="18.0" />
                                </font>
                            </Button>
                        </children>
                    </VBox>
                </children>
            </AnchorPane>
        </Tab>

        <Tab text="Store Dashboard">
            <AnchorPane style="-fx-background-color: #ffffff;">
                <children>
                    <HBox alignment="CENTER_LEFT" layoutX="40.0" layoutY="20.0" prefWidth="1200.0" spacing="40.0">
                        <children>
                            <Label text="Pacific" textFill="#000000">
                                <font>
                                    <Font name="System Bold" size="48.0" />
                                </font>
                            </Label>
                            <TextField fx:id="searchField" promptText="Search" prefHeight="50.0" prefWidth="450.0" style="-fx-background-radius: 25; -fx-border-radius: 25; -fx-border-color: lightgray; -fx-padding: 0 20;" />
                            <HBox alignment="CENTER_LEFT" spacing="30.0">
                                <Label text="Hello, sign in\nAccount &amp; Lists" style="-fx-font-weight: bold;"/>
                                <Label text="Returns\n&amp; Orders" style="-fx-font-weight: bold;"/>
                                <Label text="Cart (0)" style="-fx-font-weight: bold;"/>
                            </HBox>
                        </children>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" layoutX="40.0" layoutY="100.0" prefWidth="1200.0" spacing="30.0" style="-fx-background-color: #eae5e5; -fx-padding: 15;">
                        <children>
                            <Label text="All" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                            <Label text="Today's Deals" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Label text="Groceries" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Label text="Best Seller" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Label text="Pacific Basics" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Label text="New Releases" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        </children>
                    </HBox>

                    <VBox layoutX="40.0" layoutY="180.0" spacing="20.0">
                        <children>
                            <Label text="Unrated products," textFill="#000000">
                                <font>
                                    <Font name="System Bold" size="24.0" />
                                </font>
                            </Label>
                            
                            <HBox spacing="30.0">
                                <VBox prefWidth="300.0" spacing="12.0" style="-fx-border-color: #d9d9d9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16; -fx-background-color: white;">
                                    <children>
                                        <AnchorPane prefHeight="200.0" style="-fx-background-color: #e3e3e3; -fx-background-radius: 4;" />
                                        <Label text="iphone 17 Max">
                                            <font><Font size="16.0" /></font>
                                        </Label>
                                        <Label text="\$1199">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                        <Label text="Body text." textFill="#757575" />
                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <Button mnemonicParsing="false" onAction="#handleEditProduct" text="Edit" />
                                            <Button mnemonicParsing="false" onAction="#handleDeleteProduct" style="-fx-text-fill: red;" text="Delete" />
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox prefWidth="300.0" spacing="12.0" style="-fx-border-color: #d9d9d9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16; -fx-background-color: white;">
                                    <children>
                                        <AnchorPane prefHeight="200.0" style="-fx-background-color: #e3e3e3; -fx-background-radius: 4;" />
                                        <Label text="KTC 34 inch Monitor">
                                            <font><Font size="16.0" /></font>
                                        </Label>
                                        <Label text="\$459">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                        <Label text="Ultra-wide curved display" textFill="#757575" />
                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <Button mnemonicParsing="false" onAction="#handleEditProduct" text="Edit" />
                                            <Button mnemonicParsing="false" onAction="#handleDeleteProduct" style="-fx-text-fill: red;" text="Delete" />
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox prefWidth="300.0" spacing="12.0" style="-fx-border-color: #d9d9d9; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 16; -fx-background-color: white;">
                                    <children>
                                        <AnchorPane prefHeight="200.0" style="-fx-background-color: #e3e3e3; -fx-background-radius: 4;" />
                                        <Label text="Logitech Keyboard">
                                            <font><Font size="16.0" /></font>
                                        </Label>
                                        <Label text="\$224">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                        <Label text="Mechanical tactile switches" textFill="#757575" />
                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <Button mnemonicParsing="false" onAction="#handleEditProduct" text="Edit" />
                                            <Button mnemonicParsing="false" onAction="#handleDeleteProduct" style="-fx-text-fill: red;" text="Delete" />
                                        </HBox>
                                    </children>
                                </VBox>
                            </HBox>
                        </children>
                    </VBox>
                </children>
            </AnchorPane>
        </Tab>
    </tabs>
</TabPane>